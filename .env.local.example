# ── HIBP (Have I Been Pwned) ──────────────────────────────────
# Get key at https://haveibeenpwned.com/API/Key
# If absent, app runs in MOCK/DEMO mode automatically
HIBP_API_KEY=your_hibp_key_here

# ── Upstash Redis (Rate Limiting) ─────────────────────────────
# Get free tier at https://upstash.com
# If absent, rate limiting is disabled (demo-safe)
UPSTASH_REDIS_REST_URL=https://YOUR_DB.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_token_here

# ── Internal Cron Secret ──────────────────────────────────────
# Any random string — used to protect /api/internal/purge-expired
PURGE_CRON_SECRET=change_this_to_a_random_string

# ── App Config ────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# ── Gemini Chatbot ─────────────────────────────────────────────
# Get key from Google AI Studio
GEMINI_API_KEY=your_gemini_api_key_here

# ── OpenAI (Screenshot scam checker, legal assist) ──────────────
# Get key at https://platform.openai.com/api-keys
# If absent, screenshot checker uses heuristic fallback (no AI vision)
OPENAI_API_KEY=your_openai_key_here

# ── Demo Mode ─────────────────────────────────────────────────
# Set to "true" to force mock data (no real API calls)
NEXT_PUBLIC_DEMO_MODE=false


